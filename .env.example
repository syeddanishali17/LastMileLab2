# Docker Compose template. Copy to .env next to docker-compose.yml.
# There are no secrets. Do not put credentials or machine-specific hostnames here.
#
# Streamlit Community Cloud: do not use this file. Set BACKEND_URL in App Secrets
# to the Render HTTPS origin. See docs/deployment.md.
#
# Two-process local PowerShell (uvicorn + streamlit run): do not copy this file.
# Leave BACKEND_URL unset so the UI uses http://127.0.0.1:8000 and DuckDB uses
# data/runs/lastmile.duckdb. See docs/local_setup.md.

# Streamlit container → FastAPI on the Compose network. Compose also hardcodes this.
BACKEND_URL=http://backend:8000

LOG_LEVEL=INFO

# Container path. Compose mounts named volume duckdb_data at /app/data/runs.
DUCKDB_PATH=/app/data/runs/lastmile.duckdb

# Host port published for Streamlit. Container port stays 8501.
FRONTEND_PORT=8501

# CORS is unused for Compose: Streamlit calls FastAPI server-side (httpx).
# Do not set CORS_ORIGINS=*. Local two-process CORS still defaults to
# http://localhost:8501 in backend settings.
